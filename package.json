{
  "name": "academia-pro",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema operativo para academias desportivas",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:console": "npm run dev --workspace=@academia/console",
    "dev:family": "npm run dev --workspace=@academia/family",
    "dev:platform": "npm run dev --workspace=@academia/platform",
    "dev:site": "npm run dev --workspace=@academia/site",
    "dev:api": "npm run start:dev --workspace=@academia/api",
    "build:api": "npm run build --workspace=@academia/api",
    "start:api": "npm run start --workspace=@academia/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspace=@academia/console && npm run build --workspace=@academia/family && node scripts/collect-web.mjs",
    "build:server": "npm run build:web && npm run build:api"
  },
  "engines": {
    "node": ">=20"
  }
}
