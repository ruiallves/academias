# Onde está a API do Academias.
ACADEMIAS_API_URL=http://localhost:3000

# O mesmo valor que a API tem em AI_WORKER_TOKEN. Gerar um a sério:
#   openssl rand -hex 32
# Sem ele (ou com menos de 16 caracteres) a API recusa tudo — de propósito.
AI_WORKER_TOKEN=

# Nome desta máquina nos jobs (diagnóstico, não segurança).
AI_WORKER_NAME=local-dev

# Segundos entre perguntas "há trabalho?" quando a fila está vazia.
AI_WORKER_POLL_SECONDS=5
