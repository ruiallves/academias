# Onde está a API do Academias.
ACADEMIAS_API_URL=http://localhost:3000

# O mesmo valor que a API tem em AI_WORKER_TOKEN. Gerar um a sério:
#   openssl rand -hex 32
# Sem ele (ou com menos de 16 caracteres) a API recusa tudo — de propósito.
AI_WORKER_TOKEN=

# Nome desta máquina nos jobs (diagnóstico, não segurança).
AI_WORKER_NAME=local-dev

# Segundos entre perguntas "há trabalho?" quando a fila está vazia.
AI_WORKER_POLL_SECONDS=5

# A porta por onde o browser envia o vídeo, em blocos, directamente para este
# worker (ver academias_ai/ingest.py). O Supabase não vê o vídeo. A API tem de
# saber o endereço público desta porta em AI_WORKER_PUBLIC_URL — em produção,
# HTTPS (um túnel cloudflared serve). 0 desliga e fica só o caminho pelo Storage.
AI_WORKER_INGEST_PORT=8765

# Onde os vídeos vivem enquanto se processam. Precisa de espaço para um jogo
# inteiro (um ficheiro de 1080p de duas horas passa dos 7 GB).
AI_WORKER_SPOOL=./spool

# Um ficheiro esquecido (upload abandonado, API que nunca pediu a purga) é
# apagado ao fim destas horas, aconteça o que acontecer.
AI_WORKER_SPOOL_TTL_HOURS=72

# --- Detecção: o que decide quanto tempo um jogo demora ----------------------
# Os valores por omissão foram medidos (ver pipelines/detect_track.py). Mexe-se
# aqui para trocar tempo por precisão numa máquina concreta, sem tocar no código.
# Comparar duas configurações no mesmo clip: scripts/comparar-detector.py
#
# Quanto um frame pode ser ampliado antes de detectar (1.0 = nunca ampliar).
AI_WORKER_MAX_UPSCALE=1.5
# Tecto do lado curto em píxeis. Baixar troca precisão por tempo.
AI_WORKER_WORK_SHORT=800
# Frames por lote. 0 = decide pelo aparelho (8 com GPU, 2 em CPU).
AI_WORKER_BATCH=0
# Meia precisão na GPU. 1 = sim (ignorado em CPU).
AI_WORKER_HALF=1
# "fasterrcnn" ou "ssdlite" (mais rápido, mais fraco com jogadores sobrepostos).
AI_WORKER_DETECTOR=fasterrcnn
# Threads do PyTorch em CPU. 0 = automático.
AI_WORKER_THREADS=0
