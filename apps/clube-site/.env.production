# Sem segredos. O segredo da revalidação (SITE_REVALIDATE_SECRET) vai nas
# variáveis do projeto no Vercel, nunca aqui.
#
# `api`: o site lê os clubes da API (`/public/sites/...`). Só aparecem clubes
# que publicaram o site no menu Website. `demo` mostra o clube inventado de
# `src/dados/demo/` em qualquer endereço.
SITE_FONTE=api
SITE_API_URL=https://api.academias.pt
# Pré-visualização de um clube antes de o domínio apontar: <slug>.website.academias.pt
SITE_PREVIEW_DOMAIN=website.academias.pt
# O clube de demonstração, só usado com SITE_FONTE=demo.
SITE_DEMO_SLUG=monteverde
