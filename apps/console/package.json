{
  "name": "@academia/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:staff": "esbuild scripts/test-staff.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-staff.mjs --alias:@=./src --external:react --define:import.meta.env={} --log-level=warning && node node_modules/.cache/test-staff.mjs"
  },
  "dependencies": {
    "@academia/ui": "*",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
