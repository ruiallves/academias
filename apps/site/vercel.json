{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/software", "destination": "/produto", "permanent": true },
    { "source": "/termos", "destination": "/legal/termos-de-servico", "permanent": true },
    { "source": "/privacidade", "destination": "/legal/privacidade", "permanent": true },
    { "source": "/cookies", "destination": "/legal/cookies", "permanent": true },
    { "source": "/dpa", "destination": "/legal/dpa", "permanent": true }
  ],
  "rewrites": [{ "source": "/legal/:path*", "destination": "/legal.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
